# Linear → Settings → Security & access → Personal API keys
LINEAR_API_KEY=

# GitHub fine-grained token, scoped to the repos in orchestrator.config.ts.
# Permissions: Contents (read/write), Pull requests (read/write),
# Issues (read/write, for PR comments and labels), Checks (read), Commit statuses (read).
GITHUB_TOKEN=

# Optional: where "needs your input" pings go besides Linear.
# A Discord webhook URL (your server already has one for the bot) or an ntfy.sh topic URL.
NOTIFY_WEBHOOK_URL=
